# Google Gemini API Key from https://aistudio.google.com/api-keys (starts with AIzaSy...)
# When left blank or with a placeholder, offline curriculum fallback generation is used.
GEMINI_API_KEY=

# Model to use when a valid GEMINI_API_KEY is supplied (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Server port
PORT=3000

# Allowed frontend origin for CORS
ALLOWED_ORIGIN=http://localhost:5173
